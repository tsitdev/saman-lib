{
  "name": "samandesk",
  "version": "2.0.0-beta2.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsitdev/saman-lib.git"
  },
  "homepage": "https://github.com/tsitdev/saman-lib#readme",
  "bugs": {
    "url": "https://github.com/tsitdev/saman-lib/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/saman-desk.umd.cjs",
  "module": "./dist/saman-desk.js",
  "types": "./dist/saman-desk.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/saman-desk.d.ts",
        "default": "./dist/saman-desk.js"
      },
      "require": {
        "types": "./dist/saman-desk.d.cts",
        "default": "./dist/saman-desk.umd.cjs"
      }
    }
  },
  "scripts": {
    "start": "bun link && vp pack --watch",
    "build": "vp pack",
    "test": "vp test --project unit",
    "test:package": "bun run build && vp test --project package",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.tools.json --noEmit",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "prepare": "vp config --no-agent",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "typescript-compat": "npm:typescript@4.9.5",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.5.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0"
  }
}
