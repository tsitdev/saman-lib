{
  "name": "samandesk",
  "version": "2.0.0-beta2.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsitdev/saman-lib.git"
  },
  "homepage": "https://github.com/tsitdev/saman-lib#readme",
  "bugs": {
    "url": "https://github.com/tsitdev/saman-lib/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/saman-desk.umd.cjs",
  "module": "./dist/saman-desk.js",
  "types": "./dist/saman-desk.d.ts",
  "exports": {
    ".": {
      "types": "./dist/saman-desk.d.ts",
      "import": "./dist/saman-desk.js",
      "require": "./dist/saman-desk.umd.cjs"
    }
  },
  "scripts": {
    "start": "bun link && tsdown --watch",
    "build": "tsdown",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/node": "25.9.3",
    "tsdown": "^0.23.7",
    "typescript": "^5.8.3",
    "utility-types": "^3.11.0"
  }
}
