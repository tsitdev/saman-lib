{
  "compilerOptions": {
    "target": "ES2021",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "preserveConstEnums": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["dom", "esnext"],
    "types": ["node"]
  },
  "include": ["vite.config.ts", "library-colors.ts"]
}
